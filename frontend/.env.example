# Copy this file to .env and fill in what you need.

# Where the analysis backend runs (backend/: cd backend && uvicorn app.main:app --reload).
ANALYSIS_API_URL=http://127.0.0.1:8000
# Seconds to wait for a score before giving up (the first OCR run is slow).
ANALYSIS_TIMEOUT_S=120


# Port for the Inko web app (the analysis backend uses 8000).
INKO_PORT=5173
